generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?        @unique
  passwordHash  String?
  role          UserRole       @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  googleId      String?        @unique
  addresses     Address[]
  bookings      Booking[]
  notifications Notification[]
  reviews       Review[]
  staffProfile  StaffProfile?
  settings      UserSetting?
}
model ContactMessage {
  id        String   @id @default(uuid())

  name      String
  email     String
  phone     String?
  subject   String
  message   String

  status    ContactMessageStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Notification {
  id              String    @id @default(uuid())
  userId          String
  type            String
  title           String
  message         String
  isRead          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  readAt          DateTime?
  relatedEntity   String?
  relatedEntityId String?
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([relatedEntity, relatedEntityId])
}

model Address {
  id          String    @id @default(uuid())
  userId      String
  label       String
  addressLine String
  city        String
  county      String
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([userId])
}

model Service {
  id          String          @id @default(uuid())
  name        String
  description String?
  category    ServiceCategory
  pricingType PricingType
  basePrice   Decimal?        @db.Decimal(12, 2)
  duration    Int?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  bookings    Booking[]

  @@unique([name, category])
  @@index([category])
  @@index([isActive])
}

model Booking {
  id                String             @id @default(uuid())
  bookingNumber     String             @unique
  userId            String
  serviceId         String
  addressId         String
  status            BookingStatus      @default(PENDING)
  bookingType       BookingType
  scheduledDate     DateTime
  scheduledTime     String
  totalAmount       Decimal?           @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  address           Address            @relation(fields: [addressId], references: [id])
  service           Service            @relation(fields: [serviceId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  cleaningRequest   CleaningRequest?
  electricalRequest ElectricalRequest?
  movingRequest     MovingRequest?
  payment           Payment?
  quote             Quote?
  review            Review?
  staffAssignments  StaffAssignment[]

  @@index([userId])
  @@index([serviceId])
  @@index([addressId])
  @@index([status])
  @@index([scheduledDate])
}

model CleaningRequest {
  id                     String   @id @default(uuid())
  bookingId              String   @unique
  propertyType           String
  bedrooms               Int?
  bathrooms              Int?
  squareMeters           Decimal? @db.Decimal(10, 2)
  cleaningType           String
  additionalRequirements String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  booking                Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model MovingRequest {
  id                  String   @id @default(uuid())
  bookingId           String   @unique
  pickupAddress       String
  destinationAddress  String
  propertyType        String
  truckSize           String?
  numberOfMovers      Int?
  packingRequired     Boolean  @default(false)
  specialItems        String?
  estimatedDistanceKm Decimal? @db.Decimal(10, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model ElectricalRequest {
  id                     String   @id @default(uuid())
  bookingId              String   @unique
  propertyType           String
  numberOfFloors         Int?
  bedrooms               Int?
  newInstallation        Boolean  @default(false)
  rewiring               Boolean  @default(false)
  numberOfSockets        Int?
  numberOfLights         Int?
  distributionBoard      Boolean  @default(false)
  additionalRequirements String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  booking                Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Quote {
  id              String      @id @default(uuid())
  bookingId       String      @unique
  status          QuoteStatus @default(PENDING)
  estimatedAmount Decimal?    @db.Decimal(12, 2)
  finalAmount     Decimal?    @db.Decimal(12, 2)
  description     String?
  validUntil      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  booking         Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id                   String        @id @default(uuid())
  bookingId            String        @unique
  amount               Decimal       @db.Decimal(12, 2)
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  transactionReference String?
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([transactionReference])
}

model StaffProfile {
  id          String            @id @default(uuid())
  userId      String            @unique
  staffType   StaffType
  isAvailable Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  assignments StaffAssignment[]
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StaffAssignment {
  id          String       @id @default(uuid())
  bookingId   String
  staffId     String
  assignedAt  DateTime     @default(now())
  completedAt DateTime?
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff       StaffProfile @relation(fields: [staffId], references: [id])

  @@unique([bookingId, staffId])
  @@index([bookingId])
  @@index([staffId])
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PricingRule {
  id          String          @id @default(uuid())
  category    ServiceCategory
  name        String
  description String?
  unit        String
  unitPrice   Decimal         @db.Decimal(12, 2)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([category, name])
  @@index([category])
  @@index([isActive])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model UserSetting {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  language                 String   @default("en")
  currency                 String   @default("KES")
  timezone                 String   @default("Africa/Nairobi")
  emailBookingUpdates      Boolean  @default(true)
  emailQuoteUpdates        Boolean  @default(true)
  emailPaymentUpdates      Boolean  @default(true)
  emailServiceUpdates      Boolean  @default(true)
  emailSystemAnnouncements Boolean  @default(true)
  smsBookingUpdates        Boolean  @default(true)
  smsQuoteUpdates          Boolean  @default(true)
  smsPaymentUpdates        Boolean  @default(true)
  marketingNotifications   Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum ServiceCategory {
  CLEANING
  MOVING
  ELECTRICAL
}

enum PricingType {
  FIXED
  CALCULATED
  QUOTE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingType {
  INSTANT
  QUOTE_REQUEST
}

enum QuoteStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  MPESA
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum StaffType {
  CLEANER
  MOVER
  ELECTRICIAN
  SUPERVISOR
}
enum ContactMessageStatus {
  NEW
  READ
  RESPONDED
  CLOSED
}
